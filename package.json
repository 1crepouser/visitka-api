{
  "name": "visitka-api",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/prisma/seed.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dataloader": "2.2.3",
    "graphql": "16.15.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "multer": "2.5.0",
    "@graphql-tools/utils": "12.1.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": "test/.*\\.spec\\.ts$",
    "globalSetup": "<rootDir>/test/global-setup.ts"
  }
}
